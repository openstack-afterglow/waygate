[Unit]
Description=Waygate WireGuard agent
After=network-online.target systemd-modules-load.service systemd-tmpfiles-setup.service
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/waygate
EnvironmentFile=/etc/waygate.env
ExecStart=/opt/waygate/.venv/bin/waygate serve
UMask=0077
Restart=on-failure
RestartSec=2
RuntimeDirectory=waygate
RuntimeDirectoryMode=0700
StateDirectory=waygate
StateDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelModules=true
ProtectKernelTunables=false
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=true
RestrictSUIDSGID=true
ReadWritePaths=/etc/wireguard /var/lib/waygate /run/waygate /run/xtables.lock

[Install]
WantedBy=multi-user.target
