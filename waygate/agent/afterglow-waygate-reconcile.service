[Unit]
Description=Waygate gateway agent (reconcile and report)
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
ConditionPathExists=/etc/waygate/agent.json

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/afterglow/waygate_agent.py run
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
