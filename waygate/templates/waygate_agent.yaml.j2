#cloud-config
# Waygate WireGuard gateway agent — server: {{ server_name }}
{% if install_packages %}
package_update: true
packages:
{% for package in packages %}
  - {{ package }}
{% endfor %}
{% endif %}
# The agent script and units are always written, also for prebuilt images: a
# stale image must never keep an older (oneshot/timer) agent alive.
write_files:
  - path: /etc/waygate/agent.json
    permissions: "0600"
    content: |
      {{ agent_config_json }}
{% for file in agent_files %}
  - path: {{ file.target }}
    permissions: "{{ file.mode }}"
    content: |
{{ file.content | indent(6, first=True) }}
{% endfor %}
runcmd:
  - |
    set -eu
    timer_unit=afterglow-waygate-reconcile.timer
    timer_state=$(systemctl show --property=LoadState --value "$timer_unit")
    if [ "$timer_state" != not-found ]; then
      systemctl stop "$timer_unit"
      systemctl disable "$timer_unit"
    fi
    rm -f /etc/systemd/system/afterglow-waygate-reconcile.timer /etc/systemd/system/timers.target.wants/afterglow-waygate-reconcile.timer
    service_unit=afterglow-waygate-reconcile.service
    service_state=$(systemctl show --property=LoadState --value "$service_unit")
    if [ "$service_state" != not-found ]; then
      systemctl stop "$service_unit"
    fi
    systemctl daemon-reload
    sysctl --system
    /usr/bin/python3 /opt/afterglow/waygate_agent.py register
    systemctl enable --now afterglow-waygate-reconcile.service
