#cloud-config
# Waygate WireGuard gateway agent — server: {{ server_name }}
{% if install_packages %}
package_update: true
packages:
{% for package in packages %}
  - {{ package }}
{% endfor %}
{% endif %}
write_files:
  - path: /etc/waygate/agent.json
    permissions: "0600"
    content: |
      {{ agent_config_json }}
{% if install_packages %}
{% for file in agent_files %}
  - path: {{ file.target }}
    permissions: "{{ file.mode }}"
    content: |
{{ file.content | indent(6, first=True) }}
{% endfor %}
{% endif %}
runcmd:
  - sysctl --system
  - /usr/bin/python3 /opt/afterglow/waygate_agent.py register
  - systemctl daemon-reload
  - systemctl enable --now afterglow-waygate-reconcile.timer
