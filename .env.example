# Required on a native VM. Set this to the public IP or public DNS name
# that peers use to reach the WireGuard server.
WG_SERVER_HOST=203.0.113.10
API_AUTH_TOKEN=replace-with-a-long-random-token
API_ALLOWED_CIDRS=192.0.2.0/24

# Native VM defaults
WG_INTERFACE=wg0
WG_PORT=51820
WG_SERVER_NET=10.8.0.0/24
WG_DEFAULT_DNS=1.1.1.1
API_HOST=0.0.0.0
API_PORT=8080
WG_PERSISTENT_KEEPALIVE=25
WG_OUTBOUND_INTERFACE=eth0
ALLOW_INSECURE_HTTP=false
API_DOCS_ENABLED=false
